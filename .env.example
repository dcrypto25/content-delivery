# ==========================================
# TRAINERAPP.AI - AUTOMATED CONTENT SYSTEM
# Environment Configuration
# ==========================================

# ============ CORE SETTINGS ============
PROJECT_NAME=trainerapp-content-automation
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Base URLs
BASE_DOMAIN=trainerapp.ai
UTM_SOURCE_DEFAULT=automated_content

# Content Generation Settings
DEFAULT_CONTENT_QUANTITY=100
DAILY_POST_COUNT=4
POST_TIMES=07:00,12:00,18:00,21:00

# ============ AI PROVIDERS ============

# OpenAI (Vision Analysis + Prompt Generation)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ORG_ID=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_PROMPT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000

# Google Gemini (Image Generation - CHEAPEST!)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./config/google-credentials.json
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_IMAGE_SIZE=1080x1920

# Runway (Video Generation)
RUNWAY_API_KEY=your-runway-api-key
RUNWAY_MODEL=gen3a_turbo
RUNWAY_VIDEO_LENGTH=15
RUNWAY_BATCH_SIZE=10

# Alternative: Replicate (COST OPTIMIZATION - Only $0.0055/image!)
REPLICATE_API_TOKEN=r8_your-replicate-token
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=minimax/video-01

# ElevenLabs (Text-to-Speech - OPTIONAL)
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75

# ============ SOCIAL MEDIA APIs ============

# Instagram Business Account
INSTAGRAM_ACCESS_TOKEN=your-long-lived-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-ig-business-id
FACEBOOK_PAGE_ID=your-fb-page-id
INSTAGRAM_APP_ID=your-app-id
INSTAGRAM_APP_SECRET=your-app-secret

# TikTok Developer API
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token
TIKTOK_REFRESH_TOKEN=your-tiktok-refresh-token

# ============ STORAGE ============

# Google Drive (Free 15GB)
GDRIVE_FOLDER_ID=your-root-folder-id
GDRIVE_CREDENTIALS_PATH=./config/gdrive-credentials.json

# Alternative: AWS S3 (If scaling beyond 15GB)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=trainerapp-content

# Local Storage Paths
STORAGE_PATH=./storage
RAW_INPUTS_PATH=./storage/raw_inputs
GENERATED_PATH=./storage/generated
METADATA_PATH=./storage/metadata

# ============ N8N CONFIGURATION ============
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=your-random-encryption-key-min-10-chars
N8N_WEBHOOK_URL=https://your-domain.com
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your-secure-password

# Database for n8n (SQLite for simplicity, Postgres for scale)
DB_TYPE=sqlite
DB_SQLITE_DATABASE=./config/n8n.sqlite

# Postgres (if needed)
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=your-db-password

# ============ ANALYTICS & OPTIMIZATION ============

# Google Analytics (Optional - Track UTM performance)
GA_TRACKING_ID=G-XXXXXXXXXX
GA_MEASUREMENT_ID=

# Performance Tracking
ANALYTICS_WEBHOOK_URL=https://your-analytics-endpoint.com/webhook
TRACK_ENGAGEMENT=true
FEEDBACK_LOOP_ENABLED=true
MIN_ENGAGEMENT_RATE=0.03

# A/B Testing
AB_TEST_ENABLED=true
AB_TEST_VARIANTS=5
WINNING_VARIANT_THRESHOLD=1.5

# ============ RATE LIMITING ============

# API Rate Limits (requests per minute)
OPENAI_RPM=60
GEMINI_RPM=60
RUNWAY_RPM=10
INSTAGRAM_RPM=25
TIKTOK_RPM=10

# Batch Processing
MAX_CONCURRENT_GENERATIONS=5
BATCH_DELAY_SECONDS=2

# ============ CONTENT SETTINGS ============

# Image Specifications
IMAGE_FORMAT=jpg
IMAGE_QUALITY=90
IMAGE_SIZES=1080x1080,1080x1920
WATERMARK_ENABLED=true
WATERMARK_OPACITY=0.1
WATERMARK_POSITION=bottom-right

# Video Specifications
VIDEO_FORMAT=mp4
VIDEO_CODEC=h264
VIDEO_BITRATE=5000k
VIDEO_FPS=30
AUTO_CAPTIONS=true
TTS_ENABLED=false

# Hashtag Strategy
MIN_HASHTAGS=8
MAX_HASHTAGS=30
TRENDING_HASHTAGS_ENABLED=true

# ============ SECURITY ============

# Webhook Security
WEBHOOK_SECRET=your-webhook-secret-key
ENABLE_SIGNATURE_VERIFICATION=true

# IP Whitelist (comma-separated)
ALLOWED_IPS=127.0.0.1,your-ip-address

# ============ MONITORING ============

# Error Notifications
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
EMAIL_NOTIFICATIONS=false
ALERT_EMAIL=admin@trainerapp.ai

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=300

# ============ COST OPTIMIZATION FLAGS ============

# Use cheaper alternatives when available
USE_REPLICATE_INSTEAD_OF_RUNWAY=false
USE_FREE_TTS=true
COMPRESS_IMAGES=true
SKIP_LOW_PERFORMING_THEMES=true

# Caching
ENABLE_PROMPT_CACHE=true
CACHE_DURATION_HOURS=168
REUSE_SIMILAR_ASSETS=true

# ============ DEVELOPMENT ============

# Testing
TEST_MODE=false
DRY_RUN=false
SKIP_POSTING=false
USE_SAMPLE_DATA=false

# Logging
LOG_FILE=./logs/system.log
ERROR_LOG=./logs/error.log
ACCESS_LOG=./logs/access.log
